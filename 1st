import numpy as np
X = np.array([[2,8],[4,7],[6,9],[2,4]])
y = np.array([75,70,95,50])
eta = 0.001
n_iter = 10
w = np.zeros(1 + X.shape[1])
for i in range(n_iter):
    output = np.dot(X,w[1:]) + w[0]
    error = y - output
    w[1:] +=   eta * np.dot(X.T,error)
    w[0]  +=   eta * np.sum(error)
test1 = np.array([9,1])
result = np.dot(test1,w[1:]) + w[0]
print(result)
